#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
exec ./scripts/dev sh -c '
  set -eu
  node scripts/sync-versions.mjs --check
  node --test scripts/sync-versions.test.mjs
  cd web
  npm ci --ignore-scripts
  npm run check
  npm test
  npm run build
  cd ..
  cargo fmt --all -- --check
  cargo clippy --locked --all-targets -- -D warnings
  timeout 120 cargo test --locked
  cargo build --locked
  timeout 60 node --test scripts/service.test.mjs
'
